{
  "name": "python 3.10 (trixie)",
  "image": "mcr.microsoft.com/devcontainers/python:3-3.10-trixie",
    "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "ppa": true,
      "version": "latest"
    }
  },
  "onCreateCommand": "bash .devcontainer/onCreate.sh",
  "mounts": [
    {
      "source": "${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig",
      "target": "/home/vscode/.gitconfig",
      "type": "bind"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "editorconfig.editorconfig",
        "ms-python.python",
        "charliermarsh.ruff",
        "astral-sh.ty",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.languageServer": "Pylance",
        "ty.disableLanguageServices": true
      }
    }
  }
}
